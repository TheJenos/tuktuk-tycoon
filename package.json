{
  "name": "tuk-tuk-tycoon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#rapier": {
      "node": "@dimforge/rapier3d-compat",
      "default": "@dimforge/rapier3d"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:emu": "vite --mode emulator",
    "emulator": "firebase emulators:start --only database --project demo-tuktuk",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc && tsc -p e2e",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only database --project demo-tuktuk \"node scripts/test-rules.mjs\"",
    "test:e2e": "firebase emulators:exec --only database --project demo-tuktuk \"playwright test\"",
    "test:e2e:ui": "firebase emulators:exec --only database --project demo-tuktuk \"playwright test --ui\"",
    "deploy:rules": "firebase deploy --only database --non-interactive",
    "sim": "rolldown scripts/sim.ts --platform node --format esm --file node_modules/.cache/sim.mjs --no-codeSplitting --log-level warn && node node_modules/.cache/sim.mjs",
    "sim:bots": "rolldown scripts/sim-bots.ts --platform node --format esm --file node_modules/.cache/sim-bots.mjs --no-codeSplitting --log-level warn && node node_modules/.cache/sim-bots.mjs",
    "build:brand": "node scripts/build-brand.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d": "^0.21.0",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@discord/embedded-app-sdk": "^2.5.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "firebase": "^12.19.0",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.32.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0"
  }
}
